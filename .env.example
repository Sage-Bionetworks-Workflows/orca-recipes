# Environment variables for Local Development. See "3. Configure environment
# variables" in the README. Copy this file to .env, set AWS_PROFILE, then load it in
# each new shell from the repo root:
#   set -a; source .env; set +a

# Your AWS SSO profile with read access to the dpe-prod Secrets Manager secrets.
# See "AWS credentials" in the README.
AWS_PROFILE="<your-sso-profile>"

# Only if you used Airflow 2 on this machine before. See "2. Initialize the Airflow
# database" in the README.
# AIRFLOW_HOME="$HOME/airflow3"

# Airflow loads the DAGs from this folder. dag.test() fails with "the dag is not
# serialized" if the DAG file is not in it.
AIRFLOW__CORE__DAGS_FOLDER="$PWD/dags"
# Lets DAG files in subfolders of dags/ (for example dags/integration_tests/) import src.
PYTHONPATH="$PWD/dags"
AIRFLOW__CORE__LOAD_EXAMPLES="False"

# Read connections and variables from AWS Secrets Manager with AWS_PROFILE. The region
# is set here because a profile without one makes every lookup fail with "isn't defined".
AIRFLOW__SECRETS__BACKEND="airflow.providers.amazon.aws.secrets.secrets_manager.SecretsManagerBackend"
AIRFLOW__SECRETS__BACKEND_KWARGS="{\"connections_prefix\": \"airflow/connections\", \"variables_prefix\": \"airflow/variables\", \"profile_name\": \"$AWS_PROFILE\", \"region_name\": \"us-east-1\"}"
# To use local files and not AWS, replace the two lines above with these. See "Skip AWS
# Secrets Manager for Local Development" in CONTRIBUTING.md.
# AIRFLOW__SECRETS__BACKEND="airflow.secrets.local_filesystem.LocalFilesystemBackend"
# AIRFLOW__SECRETS__BACKEND_KWARGS='{"connections_file_path": "connections.yaml"}'

# Lets tasks pass custom dataclasses to other tasks. MWAA sets the same value.
AIRFLOW__CORE__ALLOWED_DESERIALIZATION_CLASSES_REGEXP=".*"
